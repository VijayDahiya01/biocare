# Copy to `.env` and fill in the blanks. NEVER commit the filled-in file.
#
# Blank values are secrets or machine-specific addresses. The ones that matter:
#   DATABASE_URL        postgresql+psycopg://user:pass@host:5544/biocore
#   SESSION_SECRET      long random string (NOT the dev default)
#   CSRF_SECRET         long random string (NOT the dev default)
#   SANDBOX_API_KEY     live government KYC credentials - calls are BILLED
#   SANDBOX_API_SECRET  same
#   BIOVERIFY_API_KEY   from whoever runs the BioVerify service
#   SMTP_URL            required in production, or nobody receives sign-in codes
#
# In production the app refuses to start on an unsafe combination - see
# app/core/guards.py for the full list of what it checks.

# Local run config (generated for testing). Postgres is the only external service;
# Redis and the face engine are faked in-process.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Fresh local cluster on 5544 (the installed PG17 service on 5432 is locked with an unknown password)
DATABASE_URL=

FAKE_REDIS=true
FAKE_ZEPIRIS=true
FAKE_GOV_IDENTITY=true
COOKIE_SECURE=false
DEV_LOGIN=true
DEMO_DISABLE_TOTP=true

# Real face engine on Colab (InsightFace ArcFace over cloudflared tunnel).
# Verified-identity flow uses this; legacy path stays on FAKE_ZEPIRIS.
FACE_ENGINE=remote
FACE_ENGINE_URL=
FACE_MATCH_THRESHOLD=0.40

# --- Sandbox (api.sandbox.co.in) real KYC provider ---
# Configured but NOT active: FAKE_GOV_IDENTITY=true above wins, so the clickable demo never
# fires billed calls. To route the app through Sandbox for real: set FAKE_GOV_IDENTITY=false.
# NOTE: these are LIVE keys — calls are billed and hit real NSDL/UIDAI backends.
GOV_IDENTITY_PROVIDER=sandbox
SANDBOX_BASE_URL=
SANDBOX_API_VERSION=2.0
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

SESSION_SECRET=
CSRF_SECRET=
DATA_REGION=india
