# BioCore environment — copy to .env and fill in. NEVER commit .env.
# Every value the stack needs is documented here (Phase 0 handover requirement).

# --- Data region (DPDP: must stay India) ---
DATA_REGION=india

# --- PostgreSQL ---
POSTGRES_USER=biocore
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=biocore
DATABASE_URL=postgresql+psycopg://biocore:change-me-strong@postgres:5432/biocore

# --- Redis (sessions, CSRF, rate limit, OTP, presence cache) ---
REDIS_URL=redis://redis:6379/0

# --- Milvus (vectors) ---
MILVUS_HOST=milvus
MILVUS_PORT=19530

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_KEY=biocore-minio
MINIO_SECRET=change-me-strong
MINIO_SECURE=false

# --- ZepIris (face engine) ---
# The platform's face-auth service calls the Main API; it proxies to the ML service.
ZEPIRIS_URL=http://zepiris-main:8000
ZEPIRIS_TIMEOUT_SECONDS=15
MATCH_THRESHOLD=0.5

# --- PPE / safety-gear detection (Phase 4, optional) ---
# Pluggable model server. Leave blank to skip PPE checks entirely (the platform
# runs without the model). When set, zones with require_ppe enforce it.
PPE_SERVICE_URL=
PPE_TIMEOUT_SECONDS=10

# --- RabbitMQ (async event bus) ---
RABBITMQ_USER=biocore
RABBITMQ_PASSWORD=change-me-strong
RABBITMQ_URL=amqp://biocore:change-me-strong@rabbitmq:5672//

# --- Security / sessions ---
SESSION_SECRET=change-me-64-random-bytes
CSRF_SECRET=change-me-64-random-bytes
SESSION_TTL_ADMIN_SECONDS=28800   # 8h
SESSION_TTL_MEMBER_SECONDS=14400  # 4h
COOKIE_SECURE=true                # set false only for local http dev
COOKIE_DOMAIN=

# --- Outbound messaging ---
# Real email when set (e.g. smtp://user:pass@smtp.host:587 or smtps://user:pass@host:465).
# Leave blank in dev: emails (incl. OTPs) are logged to the server instead of sent.
SMTP_URL=
SMTP_FROM=BioCore <no-reply@biocore.local>
SMS_PROVIDER_KEY=

# --- Generated documents (PDFs) ---
# Local directory for erasure certificates / 80G receipts / muster reports.
# In production point object storage (MinIO) at these instead.
FILES_DIR=generated

# --- App ---
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
API_PORT=8080
